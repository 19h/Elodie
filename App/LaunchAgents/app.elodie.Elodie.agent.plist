<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.elodie.Elodie.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Elodie</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>app.elodie.Elodie</string>
		<string>app.elodie.Elodie.dev</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Comes back after a crash, but not after Quit. CrashGuard stops a crash loop. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
</dict>
</plist>
